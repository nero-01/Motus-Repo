# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Social Login Configuration
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
EXPO_PUBLIC_FACEBOOK_APP_ID=your_facebook_app_id_here
EXPO_PUBLIC_APPLE_CLIENT_ID=your_apple_client_id_here
# Cloud Vision (planner OCR): create an API key in Google Cloud → APIs & Services.
# Enable "Cloud Vision API" for the project. Billing must be enabled on the project
# (Vision is not usable on the free tier without a linked billing account).
EXPO_PUBLIC_GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# App Configuration
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_VERSION=1.0.0

# Optional: Analytics and Monitoring
EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
EXPO_PUBLIC_ANALYTICS_ID=your_analytics_id_here
